# Optional: keep the gateway running across reboots.
#   sudo cp aicyber-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aicyber-gateway
#
# Edit WorkingDirectory and User to match where you cloned the repo.
[Unit]
Description=AI-Cyber course gateway (fair queue in front of Ollama)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=abe
WorkingDirectory=/home/abe/AI-Cyber-Intro-Cert/server
Environment="OLLAMA_URL=http://127.0.0.1:11434"
Environment="MAX_CONCURRENCY=2"
ExecStart=/home/abe/AI-Cyber-Intro-Cert/server/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
