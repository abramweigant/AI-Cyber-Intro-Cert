# Gateway configuration. Copy to /etc/aicyber-gateway/gateway.env and edit,
# then reference it from the systemd unit via EnvironmentFile=.

# --- upstream ---------------------------------------------------------------
# Ollama should listen on loopback only; the gateway is the exposed service.
OLLAMA_URL=http://127.0.0.1:11434
UPSTREAM_TIMEOUT=600

# --- scheduling -------------------------------------------------------------
# How many requests may hit Ollama at once. Size to the GPU box's VRAM, not to
# the class: three course models are 13-17 GB. Start at 2 and watch
# /admin/stats queue_wait_p95 before raising it.
MAX_CONCURRENCY=2
# One in flight per student is what makes the queue fair -- see scheduler.py.
PER_STUDENT_INFLIGHT=1
# A runaway loop gets a 429 at this depth instead of consuming memory.
PER_STUDENT_QUEUE=8

# --- access -----------------------------------------------------------------
TOKENS_FILE=/etc/aicyber-gateway/tokens.json
# For GET /admin/stats. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change-me

# Requests for anything outside this list are refused with a 403. Keeps a
# student from reaching a model the course has not budgeted for.
ALLOWED_MODELS=qwen3:8b,gemma3:27b,gpt-oss:20b,llama3.2:3b,phi4:latest

# --- limits -----------------------------------------------------------------
MAX_PROMPT_CHARS=200000
MAX_TOKENS_CAP=4096
