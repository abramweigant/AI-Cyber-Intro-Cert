# STUDENT VM ENVIRONMENT -- THIS REPO IS PUBLIC.
# .env carries each student's issued model-server token. It must never be
# committed. setup.sh creates it locally at mode 600; Module 6 Section 1.1
# is built around why it lives outside the notebook.
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.pyc

# GATEWAY SECRETS -- THIS REPO IS PUBLIC.
# tokens.json holds the SHA-256 of every student's token plus the roster. The
# hashes are not directly usable, but the file is still an access-control list
# for the GPU box and has no business in a public repo.
server/tokens.json
server/**/tokens.json
server/gateway.env
.pytest_cache/

