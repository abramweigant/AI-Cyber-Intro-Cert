{
  // Point VS Code at the venv that setup.sh creates, so the Jupyter extension
  // finds the course kernel without the student configuring anything.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Load .env into the notebook kernel's environment. This is how Module 6
  // reads LLM_BASE_URL without that value entering a cell.
  "python.envFile": "${workspaceFolder}/.env",

  // Resolve relative paths from the repository root, not the notebook's folder.
  // Module 5's final lab saves backdoor_detector.keras and Module 7 loads it;
  // without this they can disagree about where "here" is.
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true
  }
}
